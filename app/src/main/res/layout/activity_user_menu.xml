<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/textCheckerDatabase"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:showPaths="false"
    tools:context=".UserMenu">


    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="292dp"
                    android:layout_height="66dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="И в заключении"
                    android:textColor="#000000"
                    android:textSize="34sp"
                    tools:layout_editor_absoluteX="36dp"
                    tools:layout_editor_absoluteY="51dp" />

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="153dp"
                    android:layout_height="148dp"
                    android:layout_marginStart="102dp"
                    android:layout_marginTop="116dp"
                    android:layout_marginEnd="102dp"
                    android:baselineAligned="false"
                    android:contentDescription="TODO"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.083"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_launcher_foreground"
                    tools:ignore="ContentDescription,HardcodedText" />

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="121dp"
                    android:layout_height="27dp"
                    android:layout_marginStart="118dp"
                    android:layout_marginEnd="118dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/nameUser"
                    android:textColor="#000000"
                    android:textSize="15dp"
                    android:visibility="visible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/imageView" />

                <Button
                    android:id="@+id/button2"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="133dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="112dp"
                    android:layout_marginEnd="112dp"
                    android:backgroundTint="#529352"
                    android:fontFamily="sans-serif-medium"
                    android:text="*Аватарка"
                    android:textColor="#000000"
                    android:textSize="10dp"
                    app:icon="@drawable/ic_settings_black_24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textView6"
                    tools:ignore="HardcodedText" />

                <ToggleButton
                    android:id="@+id/toggleButton"
                    android:layout_width="158dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="102dp"
                    android:layout_marginEnd="97dp"
                    android:backgroundTint="#529352"
                    android:checked="true"
                    android:textOff="Женский пол"
                    android:textOn="Мужской пол"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/button2" />

                <TextView
                    android:id="@+id/textView19"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="152dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="152dp"
                    android:text="Возраст"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/toggleButton" />

                <AutoCompleteTextView
                    android:id="@+id/autoCompleteTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="80dp"
                    android:layout_marginTop="9dp"
                    android:layout_marginEnd="80dp"
                    android:digits="0123456789"
                    android:inputType="number"
                    android:text="18"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textView19" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <Button
                android:id="@+id/button"
                android:layout_width="171dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="88dp"
                android:layout_marginLeft="88dp"
                android:layout_marginEnd="61dp"
                android:layout_marginRight="61dp"
                android:layout_marginBottom="1dp"
                android:backgroundTint="#CDCFCD"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:text="Продолжить"
                android:textColor="#000000"
                app:icon="?attr/actionModePasteDrawable"
                app:iconTint="#000000"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:rippleColor="#000000" />

        </LinearLayout>
    </ScrollView>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="20dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="20dp" />

</androidx.constraintlayout.widget.ConstraintLayout>