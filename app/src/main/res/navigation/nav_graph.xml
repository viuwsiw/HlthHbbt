<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.tshk.myapplication.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_startMenu_to_FisrtFragment"
            app:destination="@id/startMenu" />
        <action
            android:id="@+id/action_FirstFragment_to_startMenu"
            app:destination="@id/startMenu" />
    </fragment>
    <fragment
        android:id="@+id/HeadFragment"
        android:name="com.tshk.myapplication.HeadFragment"
        android:label="Главное"
        tools:layout="@layout/fragment_head">

        <action
            android:id="@+id/action_AppBar_to_HeadFragment"
            app:destination="@id/HeadFragment" />
    </fragment>
    <fragment
        android:id="@+id/HealthFragment"
        android:name="com.tshk.myapplication.HealthFragment"
        android:label="Здоровье"
        tools:layout="@layout/fragment_health">

        <action
            android:id="@+id/action_AppBar_to_HeadFragment"
            app:destination="@id/HealthFragment" />
    </fragment>
    <fragment
        android:id="@+id/StatisticsHLTHFragment"
        android:name="com.tshk.myapplication.StatisticsHLTHFragment"
        android:label="Статистика"
        tools:layout="@layout/fragment_statistics_h_l_t_h">

        <action
            android:id="@+id/action_AppBar_to_StatFragment"
            app:destination="@id/StatisticsHLTHFragment" />
    </fragment>
    <activity
        android:id="@+id/startMenu"
        android:name="com.tshk.myapplication.StartMenu"
        android:label="activity_start_menu"
        tools:layout="@layout/activity_start_menu" />
    <activity
        android:id="@+id/userMenu"
        android:name="com.tshk.myapplication.UserMenu"
        android:label="activity_user_menu"
        tools:layout="@layout/activity_user_menu" />
</navigation>