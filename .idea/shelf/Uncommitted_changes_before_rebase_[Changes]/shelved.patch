+
+import java.util.List;
+
+@Entity(tableName = "health_data")
+public class HealthData {
+    @PrimaryKey(autoGenerate = true)
+    private int id;
+
+    private int waterIntake;
+
+    private String dateTime; // Добавлено поле dateTime
+
+    // getters and setters
